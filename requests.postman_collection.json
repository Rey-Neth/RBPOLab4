{
  "info": {
    "name": "Лабораторная 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userPassword",
      "value": "TestAccount123!"
    },
    {
      "key": "adminPassword",
      "value": "TestAdmin123!"
    }
  ],
  "item": [
    {
      "name": "01. Получить CSRF-токен",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/csrf",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ownerLogin', 'user_' + Date.now().toString(36));",
              "pm.collectionVariables.set('endDate', new Date(Date.now() + 86400000).toISOString().slice(0,19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Пароли и хеши скрыты', function () { pm.expect(pm.response.text()).not.to.include('\"password\"'); pm.expect(pm.response.text()).not.to.include('\"passwordHash\"'); pm.expect(pm.response.text()).not.to.include('password_hash'); });",
              "pm.collectionVariables.set('csrf', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Слабый пароль: отказ",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{ownerLogin}}\",\"password\":\"weak\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Пароли и хеши скрыты', function () { pm.expect(pm.response.text()).not.to.include('\"password\"'); pm.expect(pm.response.text()).not.to.include('\"passwordHash\"'); pm.expect(pm.response.text()).not.to.include('password_hash'); });"
            ]
          }
        }
      ]
    },
